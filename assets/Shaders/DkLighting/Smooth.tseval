// Mesh smoothing, tessellation evaluation of the lit pass: places each new
// vertex on the smoothed surface (Smooth.glsllib) and lights it exactly like
// DkLighting/Vertex lights a vertex (VertexLighting.glsllib); a triangle that
// isn't split blends its corners' colours from the vertex stage. Vertex.frag
// draws it.
layout(triangles, fractional_odd_spacing, ccw) in;

#import "Common/ShaderLib/GLSLCompat.glsllib"
#import "Common/ShaderLib/Instancing.glsllib"
#import "Shaders/DkLighting/DkFalloff.glsllib"
#import "Shaders/DkLighting/VertexLighting.glsllib"
#import "Shaders/DkLighting/Smooth.glsllib"

in vec3 tcPosition[];
in vec3 tcNormal[];
in vec2 tcTexCoord[];
in vec3 tcColor[];
patch in float tcSplit;

out vec2 texCoord;
out vec3 vVertexColor;
out vec3 vOverlay;
out vec3 vGlow;
out vec2 liquidTexCoord;
out vec2 embmEnvironmentTexCoord;
out float vSurfaceVisibility;

void main() {
    vec3 coord = gl_TessCoord;
    vec3 p[3] = vec3[](tcPosition[0], tcPosition[1], tcPosition[2]);
    vec3 n[3] = vec3[](tcNormal[0], tcNormal[1], tcNormal[2]);
    vec3 normal;
    vec4 modelSpacePos = vec4(smoothSurface(p, n, coord, normal), 1.0);
    texCoord = coord.x * tcTexCoord[0] + coord.y * tcTexCoord[1] + coord.z * tcTexCoord[2];
    gl_Position = TransformWorldViewProjection(modelSpacePos);

    liquidTexCoord = texCoord;
    embmEnvironmentTexCoord = vec2(0.5);
    vSurfaceVisibility = 1.0;

    if (tcSplit > 0.5) {
        vec3 worldPos = TransformWorld(modelSpacePos).xyz;
        vec3 worldNormal = normalize(TransformWorldNormal(normal));
        vVertexColor = dkVertexLight(worldPos, worldNormal, vSurfaceVisibility);
    } else {
        // Not split: only the corners, already lit by the vertex stage
        vVertexColor = coord.x * tcColor[0] + coord.y * tcColor[1] + coord.z * tcColor[2];
    }
    vOverlay = m_TintOverlay.rgb;
    vGlow = vec3(0.0);
}

// DkLighting/Vertex for mesh smoothing: the same parameters and look, but
// every technique tessellates the (animated) mesh into a smooth surface, PN
// triangles or Phong tessellation (Shaders/DkLighting/Smooth.glsllib).
// VertexTextureBackend gives this to the animated geometries of models while
// smoothing is on and draws their meshes as patches of three, so every
// technique here needs the tessellation stages.
MaterialDef DK Smooth Lighting {

    MaterialParameters {
        Texture2D DiffuseMap

        // KmfModelLoader.setMaterialFlags sets this on every material it
        // creates (terrain included, e.g. RANDOM_TEXTURE/alpha pieces) --
        // must be declared here or that call throws.
        Float AlphaDiscardThreshold

        // Custom shadow passes preserve the same cutout coverage as color.
        Boolean UseAlphaCoverage : true
        Int FilterMode
        Boolean HardwareShadows
        Texture2D ShadowMap0
        Texture2D ShadowMap1
        Texture2D ShadowMap2
        Texture2D ShadowMap3
        Texture2D ShadowMap4
        Texture2D ShadowMap5
        Float ShadowIntensity
        Vector4 Splits
        Vector2 FadeInfo
        Matrix4 LightViewProjectionMatrix0
        Matrix4 LightViewProjectionMatrix1
        Matrix4 LightViewProjectionMatrix2
        Matrix4 LightViewProjectionMatrix3
        Matrix4 LightViewProjectionMatrix4
        Matrix4 LightViewProjectionMatrix5
        Vector3 LightPos
        Vector3 LightDir
        Float PCFEdge
        Float ShadowMapSize
        Boolean BackfaceShadows

        // The VERTEX_TEXTURE animation backend (see VertexAnimation.glsllib).
        // Set per geometry by PoseTrack, as material parameter overrides.
        Texture2D VertexAnimationMap -LINEAR
        Int VertexAnimationWidth
        Int VertexAnimationVertices
        Int VertexAnimationFrameA
        Int VertexAnimationFrameB
        Float VertexAnimationWeight


        // Vertex ambient: a per-terrain-type constant, 0..1,
        // already converted from the file's 0..511 channel + over-bright
        // bits by the Java side. Only used until the AmbientMap below is
        // bound. Defaulted to black -- an unset Color MaterialParameter is an
        // uninitialized GPU uniform, not zero.
        Color Ambient : 0.0 0.0 0.0 0.0

        // Tile highlight, as in the original:
        // Tint is ADDED to the tile's lighting at every vertex (tag = (128,
        // 128, 200)/255, flash = (1, 0, 0)), and TintOverlay is the colour of
        // a second, additive pass over the same triangles, scaled by that
        // same lit vertex colour (tag = (63, 64, 255)/255 "BlueTexture",
        // flash = (255, 64, 65)/255 "RedTexture"). Per tile, not blended
        // across tile borders: a selection must read as exactly that tile.
        Color Tint : 0.0 0.0 0.0 0.0
        Color TintOverlay : 0.0 0.0 0.0 0.0

        // Map-sized per-tile data (rgb = ambient / 2, a = explored flag),
        // sampled bilinearly at the vertex's world position so ambient and
        // fog fade between tiles instead of stepping at tile borders. When
        // bound (by SceneLights) it replaces the constant Ambient above.
        Texture2D AmbientMap
        Vector2 AmbientMapSize

        // Every light near the camera plus the global ambient, shared by ALL
        // terrain materials and rewritten each frame by SceneLights, so no two materials can ever disagree about a light.
        // Layout: texel 0 = (light count, global ambient rgb); then three
        // texels per light: (position xyz, radius), (colour rgb, intensity),
        // (flags, 0, 0, 0). Flags: 1 = smooth monotonic falloff (the cursor
        // light), 2 = may shine on unexplored ground (claim scan, cursor),
        // 4 = override light (player-coloured creatures).
        Texture2D LightData

        // Scale of the minimum light every explored vertex gets: 1 for
        // walkable terrain, 0 for solid terrain (black where no light reaches)
        Float MinLight : 1.0

        // Absolute minimum light of explored vertices, independent of the
        // global DK_MIN_AMBIENT_FLOOR (which is 0): the model viewer's "lit
        // solid rock" sets it so rock is visible where no light reaches.
        Float RockFloor : 0.0

        // Scale of the per-tile ambient sampled from AmbientMap. 0 for solid
        // terrain: the map is sampled bilinearly, so without this a wall's
        // vertices on the border to a floor tile take half of the floor's
        // ambient.
        Float AmbientScale : 1.0

        // Leave out the lights carried by game objects (flag 32 of the light
        // data): for the parts of the dungeon heart, which take no light from
        // the heart's own glow. Models only, terrain never sets it.
        Boolean IgnoreObjectLights

        // World-space centre of the model. When set, object lights
        // are attenuated once from this point, as the original does for
        // object / creature meshes, instead of per vertex. Models only.
        Vector3 MeshCenter

        // Animated texture (water): DiffuseMap is a strip of NumberOfTiles
        // equally wide frames, stepped Speed times a second. Unset = static.
        Int NumberOfTiles
        Int Speed
        Boolean UseAnimationFrame
        Int AnimationFrame : 0

        // Mesh smoothing (VertexTextureBackend.configureSmoothing): the key
        // frames' normals, set per geometry by PoseTrack like the positions
        Texture2D VertexAnimationNormalMap -LINEAR
        // Most segments an edge is split into, and how many pixels on screen
        // one segment should cover at least
        Float TessellationSegments : 8.0
        Float TessellationPixels : 6.0
        // Phong tessellation instead of PN triangles
        Boolean PhongTessellation
    }

    Technique {
        VertexShader GLSL400: Shaders/DkLighting/Smooth.vert
        TessellationControlShader GLSL400: Shaders/DkLighting/Smooth.tsctrl
        TessellationEvaluationShader GLSL400: Shaders/DkLighting/Smooth.tseval
        FragmentShader GLSL400: Shaders/DkLighting/Vertex.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldMatrix
            WorldNormalMatrix
            WorldViewMatrix
            ProjectionMatrix
            Resolution
            Time
        }

        Defines {
            VERTEX_ANIMATION : VertexAnimationMap
            VERTEX_NORMALS : VertexAnimationNormalMap
            PHONG_TESSELLATION : PhongTessellation
            CONTROLLED_ANIMATION : UseAnimationFrame
            ANIMATED_TILES : NumberOfTiles
            ALPHA_COVERAGE : UseAlphaCoverage
            DISCARD_ALPHA : AlphaDiscardThreshold
            AMBIENT_MAP : AmbientMap
            LIGHT_DATA : LightData
            IGNORE_OBJECT_LIGHTS : IgnoreObjectLights
            MESH_CENTER : MeshCenter
        }
    }

    Technique PreShadow {
        VertexShader GLSL400: Shaders/DkLighting/Smooth.vert
        TessellationControlShader GLSL400: Shaders/DkLighting/Smooth.tsctrl
        TessellationEvaluationShader GLSL400: Shaders/DkLighting/SmoothPreShadow.tseval
        FragmentShader GLSL400: Shaders/LightingSprite.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldViewMatrix
            ProjectionMatrix
            Resolution
            Time
        }
        Defines {
            VERTEX_ANIMATION : VertexAnimationMap
            VERTEX_NORMALS : VertexAnimationNormalMap
            PHONG_TESSELLATION : PhongTessellation
            CONTROLLED_ANIMATION : UseAnimationFrame
            ANIMATED_TILES : NumberOfTiles
            ALPHA_COVERAGE : UseAlphaCoverage
            DISCARD_ALPHA : AlphaDiscardThreshold
        }
        ForcedRenderState {
            FaceCull Off
            DepthTest On
            DepthWrite On
            PolyOffset 5 3
            ColorWrite Off
        }
    }

    Technique PostShadow {
        VertexShader GLSL400: Shaders/DkLighting/Smooth.vert
        TessellationControlShader GLSL400: Shaders/DkLighting/Smooth.tsctrl
        TessellationEvaluationShader GLSL400: Shaders/DkLighting/SmoothPostShadow.tseval
        FragmentShader GLSL400: Shaders/PostShadowSprite.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldMatrix
            WorldViewMatrix
            ProjectionMatrix
            Resolution
            ViewProjectionMatrix
            ViewMatrix
            NormalMatrix
            Time
        }
        Defines {
            VERTEX_ANIMATION : VertexAnimationMap
            VERTEX_NORMALS : VertexAnimationNormalMap
            PHONG_TESSELLATION : PhongTessellation
            CONTROLLED_ANIMATION : UseAnimationFrame
            ANIMATED_TILES : NumberOfTiles
            ALPHA_COVERAGE : UseAlphaCoverage
            DISCARD_ALPHA : AlphaDiscardThreshold
            HARDWARE_SHADOWS : HardwareShadows
            FILTER_MODE : FilterMode
            PCFEDGE : PCFEdge
            SHADOWMAP_SIZE : ShadowMapSize
            FADE : FadeInfo
            PSSM : Splits
            POINTLIGHT : LightViewProjectionMatrix5
            BACKFACE_SHADOWS : BackfaceShadows
        }
        ForcedRenderState {
            Blend Modulate
            DepthWrite Off
            PolyOffset -0.1 0
        }
    }
}

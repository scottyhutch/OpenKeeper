MaterialDef DK Flat Lighting {

    MaterialParameters {
        Texture2D DiffuseMap

        // KmfModelLoader.setMaterialFlags sets this on alpha-flagged
        // materials -- must be declared here or that call throws.
        Float AlphaDiscardThreshold

        // Custom shadow passes preserve the same cutout coverage as color.
        Boolean UseAlphaCoverage : true
        Int FilterMode
        Boolean HardwareShadows
        Texture2D ShadowMap0
        Texture2D ShadowMap1
        Texture2D ShadowMap2
        Texture2D ShadowMap3
        Texture2D ShadowMap4
        Texture2D ShadowMap5
        Float ShadowIntensity
        Vector4 Splits
        Vector2 FadeInfo
        Matrix4 LightViewProjectionMatrix0
        Matrix4 LightViewProjectionMatrix1
        Matrix4 LightViewProjectionMatrix2
        Matrix4 LightViewProjectionMatrix3
        Matrix4 LightViewProjectionMatrix4
        Matrix4 LightViewProjectionMatrix5
        Vector3 LightPos
        Vector3 LightDir
        Float PCFEdge
        Float ShadowMapSize
        Boolean BackfaceShadows

        // The VERTEX_TEXTURE animation backend (see VertexAnimation.glsllib).
        // Set per geometry by PoseTrack, as material parameter overrides.
        Texture2D VertexAnimationMap -LINEAR
        Int VertexAnimationWidth
        Int VertexAnimationVertices
        Int VertexAnimationFrameA
        Int VertexAnimationFrameB
        Float VertexAnimationWeight


        // Global ambient: the video "ambient light" setting.
        // Defaulted to black -- materials that nobody pushes a live value
        // into (e.g. batched room geometry,
        // see MapViewController.applyTerrainLighting) must not read an
        // uninitialized GPU uniform here.
        Color GlobalAmbient : 0.0 0.0 0.0 0.0

        // The "flat" evaluation: one sample at the mesh
        // origin, normal term dropped, summed over every in-range light by
        // SceneLights on the CPU (there is no per-fragment light loop for
        // this technique) and uploaded as a single additive colour, 0..1.
        // Defaulted to black for the same reason as GlobalAmbient above.
        Color FlatLight : 0.0 0.0 0.0 0.0

        // Kept only so the existing
        // selection/flash/highlight code (AssetUtils.setModelHighlight,
        // MapViewController's tile flash/tag, Arrow/HighlightBlinkControl)
        // can keep tinting geometries without special-casing this def.
        // Simply added on top of the lit colour, not a full override.
        Color Ambient : 0.0 0.0 0.0 0.0

        // Highlight, same as Vertex's tile flash: Tint is added to the
        // lit colour, TintOverlay is a flat additive pass scaled by it.
        // Black = off.
        Color Tint : 0.0 0.0 0.0 0.0
        Color TintOverlay : 0.0 0.0 0.0 0.0
        Boolean UseMaterialColors
    }

    Technique {
        VertexShader GLSL150: Shaders/DkLighting/Flat.vert
        FragmentShader GLSL150: Shaders/DkLighting/Flat.frag

        WorldParameters {
            WorldViewProjectionMatrix
        }

        Defines {
            VERTEX_ANIMATION : VertexAnimationMap
            ALPHA_COVERAGE : UseAlphaCoverage
            DISCARD_ALPHA : AlphaDiscardThreshold
        }
    }

    Technique PreShadow {
        VertexShader GLSL330 GLSL300: Shaders/AnimationShadow.vert
        FragmentShader GLSL330 GLSL300: Shaders/LightingSprite.frag
        WorldParameters {
            WorldViewProjectionMatrix
            Time
        }
        Defines {
            VERTEX_ANIMATION : VertexAnimationMap
            ALPHA_COVERAGE : UseAlphaCoverage
            DISCARD_ALPHA : AlphaDiscardThreshold
        }
        ForcedRenderState {
            FaceCull Off
            DepthTest On
            DepthWrite On
            PolyOffset 5 3
            ColorWrite Off
        }
    }
    // SSAO's normal pass: without it SSAOFilter leaves these geometries out
    // of its normal buffer, and the occlusion uses the buffer's clear colour
    Technique PreNormalPass {
        VertexShader GLSL330 GLSL300: Shaders/AnimationNormal.vert
        FragmentShader GLSL330 GLSL300: Shaders/AnimationNormal.frag
        WorldParameters {
            WorldViewProjectionMatrix
            NormalMatrix
            Time
        }
        Defines {
            VERTEX_ANIMATION : VertexAnimationMap
            ALPHA_COVERAGE : UseAlphaCoverage
            DISCARD_ALPHA : AlphaDiscardThreshold
        }
    }
    Technique PostShadow {
        VertexShader GLSL330 GLSL300: Shaders/PostShadowSprite.vert
        FragmentShader GLSL330 GLSL300: Shaders/PostShadowSprite.frag
        WorldParameters {
            WorldViewProjectionMatrix
            WorldMatrix
            ViewProjectionMatrix
            ViewMatrix
            NormalMatrix
            Time
        }
        Defines {
            VERTEX_ANIMATION : VertexAnimationMap
            ALPHA_COVERAGE : UseAlphaCoverage
            DISCARD_ALPHA : AlphaDiscardThreshold
            HARDWARE_SHADOWS : HardwareShadows
            FILTER_MODE : FilterMode
            PCFEDGE : PCFEdge
            SHADOWMAP_SIZE : ShadowMapSize
            FADE : FadeInfo
            PSSM : Splits
            POINTLIGHT : LightViewProjectionMatrix5
            BACKFACE_SHADOWS : BackfaceShadows
        }
        ForcedRenderState {
            Blend Modulate
            DepthWrite Off
            PolyOffset -0.1 0
        }
    }
}
